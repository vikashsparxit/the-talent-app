# Edge Function secrets
# Copy to .env and fill in values. Never commit .env.
#
# --- Local development (supabase functions serve) ---
#   supabase functions serve --env-file ../../.env.local
#   Or: supabase functions serve --env-file ./supabase/functions/.env
#
# --- Self-hosted / open-source Supabase (no Dashboard Secrets UI) ---
#   Load this file in the environment of your Edge Functions runtime:
#   - In docker-compose: for the "functions" service, add env_file or environment:
#       env_file: .env
#     or
#       environment:
#         - GOOGLE_AI_API_KEY=your_key_here
#   - Or ensure the process that runs Edge Functions reads GOOGLE_AI_API_KEY from its env.
#
# --- Supabase Cloud (hosted) ---
#   Dashboard → Project Settings → Edge Functions → Secrets

GOOGLE_AI_API_KEY=
# Or use: GEMINI_API_KEY=

# Tavily web search for recruiter "Market check" (salary-market-check) and company website enrichment
# (enrich-company-websites). Server-only — never expose to the browser.
TAVILY_API_KEY=

# Transactional + auth email via AWS SES SMTP (send-auth-email hook replaces GoTrue SMTP when enabled)
# Set on the FUNCTIONS container (not auth). GoTrue-style names are accepted as fallbacks:
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_ADMIN_EMAIL
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASSWORD=
# Optional override when email_settings.from_address is empty (default: system@thetalentapp.io)
EMAIL_FROM=system@thetalentapp.io

# Auth Send Email Hook secret — generate in Dashboard → Auth → Hooks → Send Email
# Format: v1,whsec_<base64_secret> (32–88 chars). Also set in config.toml for local dev.
SEND_AUTH_EMAIL_HOOK_SECRET=

# Public app URL for email image links and CTAs (e.g. https://talent.example.com)
PUBLIC_APP_URL=

# Browser origins allowed to call Edge Functions (CORS), comma-separated,
# e.g. https://talent.example.com,https://staging.talent.example.com
# Falls back to PUBLIC_APP_URL when unset. With neither set, only
# http://localhost and http://127.0.0.1 origins are allowed (local development).
ALLOWED_ORIGINS=

# Web Push (push-config, send-push). One key pair per instance; generate with
#   npx web-push generate-vapid-keys
# and keep a backup: changing or losing the keys breaks every existing device
# subscription. VAPID_SUBJECT is a contact for the push services (mailto: or https:).
# Push stays off until all three are set. See docs/WEB_PUSH.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional: marketing/OSS site for email footer (defaults to PUBLIC_APP_URL or GitHub)
# PUBLIC_MARKETING_URL=https://github.com/vikashsparxit/the-talent-app

# Optional: default IANA timezone for interview emails, invites and the daily digest when a
# user has not set one in their profile (e.g. Europe/Berlin). Falls back to the
# system_config 'default_timezone' row, then UTC.
# DEFAULT_TIMEZONE=

# Optional: override Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Supabase injects these when deployed; for local serve they come from supabase start
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Self-hosted only: public URL of the Supabase API (e.g. https://supabase.example.com).
# Required when SUPABASE_URL is an internal address such as http://kong:8000, so that
# signed resume URLs are reachable from browsers and public resume URLs are accepted.
# SUPABASE_PUBLIC_URL=
